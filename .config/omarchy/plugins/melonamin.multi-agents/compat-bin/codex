#!/usr/bin/env bash

set -euo pipefail

real_codex=${CODEX_REAL_BIN:-}
if [[ -z "$real_codex" ]]; then
    echo "multi-agents: CODEX_REAL_BIN is not set" >&2
    exit 127
fi

args=()
while (( $# > 0 )); do
    if [[ ( "$1" == "-a" || "$1" == "--ask-for-approval" ) && "${2:-}" == "untrusted" ]]; then
        args+=("$1" "never")
        shift 2
    else
        args+=("$1")
        shift
    fi
done

exec "$real_codex" "${args[@]}"
